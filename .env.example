APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Strictly optional. The engine computes every figure; a model is only ever
# handed a finished answer and asked to phrase it more naturally, and any
# rewrite that drops a naira figure is discarded. Leave this blank and the
# product works exactly the same, in the engine's own words.
#
# The key belongs here and nowhere else. It is never logged, never returned
# in a response, and never sent to the browser.

# --- Queue ---------------------------------------------------------------
# The welcome email is queued so SMTP never sits between somebody and the
# screen they just built.
#
#   database  works everywhere, needs a worker running (jobs table exists)
#   sync      runs inline — fine locally, blocks the request
#   redis     what Laravel Cloud gives you
#
# Locally, run the worker in a second terminal:
#   php artisan queue:work --tries=3
QUEUE_CONNECTION=database

# --- Mail ----------------------------------------------------------------
# ACTIVE: Mailtrap. Catches everything, delivers nothing — safe to test with
# real-looking addresses. Credentials: Mailtrap > Email Testing > your inbox >
# Integrations > "Laravel 9+".
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@moneypilot.ng"
MAIL_FROM_NAME="MoneyPilot"

# --- Resend (for production, when you are ready) --------------------------
# resend/resend-laravel IS INSTALLED, so this really is just uncommenting. It
# was not before: config/mail.php has carried a 'resend' mailer since the
# Laravel skeleton, but without the package Laravel has no such transport and
# every send died with `Class "Resend" not found` — a failure that only shows
# up once mail is already switched to production.
#
# To switch: comment out the five Mailtrap lines above (MAIL_MAILER, MAIL_HOST,
# MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD) and uncomment the three below. The
# notifications themselves are transport-agnostic and do not change.
#
# Resend needs the sending domain verified FIRST, and MAIL_FROM_ADDRESS must be
# on that domain, or EVERY send is rejected. Verified against the live API:
#
#   from hello@moneypilot.ng  -> all 3 rejected:
#     "The moneypilot.ng domain is not verified.
#      Please, add and verify your domain on https://resend.com/domains"
#   from onboarding@resend.dev -> all 3 sent and delivered
#
# So the key and the transport are fine; the domain is the only blocker. Either
# verify moneypilot.ng at resend.com/domains (needs DNS access), or fall back to
# MAIL_FROM_ADDRESS="onboarding@resend.dev" — but note Resend only lets that
# shared sender reach the address that owns the Resend account, so it is fine
# for a smoke test and NOT fine for registering demo members.
#
# Then confirm it end to end before you need it:  php artisan mail:check
#
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM_ADDRESS="hello@yourdomain.com"

# --- OpenAI --------------------------------------------------------------
# Strictly optional. The engine computes every figure; the model is only ever
# handed a finished answer and asked to phrase it more naturally, and any
# rewrite that drops, alters or invents a naira figure is discarded. Leave this
# blank and the product works exactly the same, in the engine's own words.
#
# The key belongs here and nowhere else. It is never logged, never returned in
# a response, and never sent to the browser. .env is gitignored; .env.example
# is not — never paste a real key into this file.
#
# To switch it on:
#   1. OPENAI_API_KEY=sk-...        (platform.openai.com > API keys)
#   2. OPENAI_ENABLED=true          both are required; the key alone does nothing
#   3. php artisan ai:check         one real call, confirms key, model and guard
#
# OPENAI_MODEL must be a Chat Completions model that accepts `max_tokens`.
# gpt-4o-mini and gpt-4o do. The newer reasoning models want
# `max_completion_tokens` and will 400 until OpenAiService::chat() is changed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false
